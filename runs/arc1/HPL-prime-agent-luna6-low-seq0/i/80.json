n","input":"import pathlib\np=base/'programs'/'task-de77c352.py'; p.parent.mkdir(exist_ok=True)\ns='''def transform(grid):\n    a=[row[:] for row in grid]\n    h,w=len(a),len(a[0])\n    # For each color, find its bounding box; hollow rectangular frames enclose background cells.\n    from collections import defaultdict\n    pts=defaultdict(list)\n    bg=None\n    for r in range(h):\n        for c in range(w):\n            if a[r][c] != grid[0][0]: pts[a[r][c]].append((r,c))\n    for color,cells in pts.items():\n        r0=min(r for r,c in cells); r1=max(r for r,c in cells)\n        c0=min(c for r,c in cells); c1=max(c for r,c in cells)\n        if r1-r0<2 or c1-c0<2: continue\n        # Treat each enclosed rectangular cavity with a fully matching perimeter.\n        if all(a[r0][c]==color for c in range(c0,c1+1)) and all(a[r1][c]==color for c in range(c0,c1+1)) and all(a[r][c0]==color and a[r][c1]==color for r in range(r0,r1+1)):\n            interior=[(r,c) for r in range(r0+1,r1) for c in range(c0+1,c1) if a[r][c]==grid[0][0]]\n            fill=7 if len(interior)==1 else 2\n            for r,c in interior: a[r][c]=fill\n    return a\n'''\np.write_text(s)\nexec(compile(s,str(p),'exec'),globals()); test=[[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[8,8,8,8,8,3,3,3,3,8,8,8,8,8,8,8,6,6,6,6,8,8],[8,8,8,8,8,3,8,8,3,8,8,3,3,3,8,8,6,8,8,6,8,8],[8,8,8,8,8,3,8,8,3,8,8,3,8,3,8,8,6,8,8,6,8,8],[8,8,8,8,8,3,3,3,3,8,8,3,3,3,8,8,6,6,6,6,8,8],[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[8,8,8,8,8,8,8,8,5,5,5,5,5,5,5,8,8,8,8,8,8,8],[8,8,8,6,6,6,6,8,5,8,8,8,8,8,5,8,8,8,8,8,8,8],[8,8,8,6,8,8,6,8,5,8,8,8,8,8,5,8,1,1,1,1,8,8],[8,8,8,6,8,8,6,8,5,8,8,8,8,8,5,8,1,8,8,1,8,8],[8,8,8,6,6,6,6,8,5,8,8,8,8,8,5,8,1,8,8,1,8,8],[8,8,8,8,8,8,8,8,5,8,8,8,8,8,5,8,1,1,1,1,8,8],[8,8,8,8,8,8,8,8,5,5,5,5,5,5,5,8,8,8,8,8,