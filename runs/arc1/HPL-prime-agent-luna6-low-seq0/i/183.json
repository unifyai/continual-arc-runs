","input":"open(p,'w').write('''def transform(grid):\\n    out = [row[:] for row in grid]\\n    bg = max(set(v for row in grid for v in row), key=lambda v: sum(r.count(v) for r in grid))\\n    colors = set(v for row in grid for v in row if v != bg)\\n    for r, row in enumerate(grid):\\n        for c in range(1, len(row)-1):\\n            if row[c] == bg and row[c-1] in colors and row[c+1] in colors:\\n                out[r][c] = 2\\n    return out\\n''')","t":1790702214.3288336,"stored":["programs/task-a00df3a5.py"],"output":"405"}],"action":{"type":"finish"}}]}