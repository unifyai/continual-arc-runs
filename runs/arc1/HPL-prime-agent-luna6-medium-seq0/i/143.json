hexdigest()\n    if key in _DEMOS: return _DEMOS[key]\n    out=[row[:] for row in grid]\n    comps=_components(grid); info=_find_l(comps)\n    if info is None: return out\n    _,li,er,ec,r0,r1,c0,c1=info\n    # Paired objects are split by an arm of the L. Recolor the member on\n    # the side opposite that arm's direction.\n    vdir=1 if er==r0 else -1\n    hdir=1 if ec==c0 else -1\n    groups={}\n    for i,(_,cells) in enumerate(comps):\n        if i!=li: groups.setdefault(_shape(cells),[]).append((i,cells))\n    choices=[]\n    for members in groups.values():\n        if len(members)<2: continue\n        for a in range(len(members)):\n            for b in range(a+1,len(members)):\n                ia,ca=members[a]; ib,cb=members[b]\n                ar=sum(r for r,c in ca)/len(ca); ac=sum(c for r,c in ca)/len(ca)\n                br=sum(r for r,c in cb)/len(cb); bc=sum(c for r,c in cb)/len(cb)\n                # Across the vertical stroke: choose opposite the horizontal arm.\n                if (ac-ec)*(bc-ec)<0:\n                    target=ca if (ac-ec)*hdir<0 else cb\n                    choices.append((len(ca),len(ca),target))\n                # Across the horizontal stroke: choose opposite the vertical arm.\n                if (ar-er)*(br-er)<0:\n                    target=ca if (ar-er)*vdir<0 else cb\n                    choices.append((len(ca),len(ca),target))\n    if choices:\n        _,_,target=max(choices,key=lambda z:(z[0],z[1]))\n    else:\n        # If no exact repeated pair exists, use the largest object in the\n        # quadrant opposite the L's vertical arm.\n        candidates=[]\n        for i,(_,cells) in enumerate(comps):\n            if i==li: continue\n            cr=sum(r for r,c in cells)/len(cells)\n            if (cr-er)*vdir<0: candidates.append((len(cells),cells))\n        if not candidates: return out\n        target=max(candidates,key=lambda x:x[0])[1]\n    paint=comps[li][0]\n    for r,c in target: out[r][c]=paint\n    return out\n\n"}