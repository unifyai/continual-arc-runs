t\n    target = max(candidates, key=lambda z: (\n        z[3] - z[2], z[3], len(z[1])\n    ))\n    for r, c in target[1]:\n        out[r][c] = key_color\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}}]}