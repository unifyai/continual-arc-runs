\n                    while 0 <= nr < h and 0 <= nc < w and out[nr][nc] == bg:\n                        out[nr][nc] = color\n                        nr += ar\n                        nc += ac\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}}]}