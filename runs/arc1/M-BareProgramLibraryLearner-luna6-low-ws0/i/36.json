# The isolated 8s are placement markers; the connected colored shape is the pattern.\n    markers = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == 8]\n    cells = {(r, c) for r in range(h) for c in range(w)\n             if grid[r][c] != bg and grid[r][c] != 8}\n\n    # Find the connected pattern component.\n    components = []\n    while cells:\n        start = cells.pop()\n        comp = {start}\n        q = [start]\n        while q:\n            r, c = q.pop()\n            for p in ((r-1,c), (r+1,c), (r,c-1), (r,c+1)):\n                if p in cells:\n                    cells.remove(p)\n                    comp.add(p)\n                    q.append(p)\n        components.append(comp)\n\n    pattern = max(components, key=len)\n    minr = min(r for r, c in pattern)\n    maxr = max(r for r, c in pattern)\n    minc = min(c for r, c in pattern)\n    maxc = max(c for r, c in pattern)\n    ar, ac = (minr + maxr) // 2, (minc + maxc) // 2\n    offsets = [(r-ar, c-ac, grid[r][c]) for r, c in pattern]\n\n    out = [row[:] for row in grid]\n    for r, c in markers:\n        for dr, dc, color in offsets:\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h and 0 <= cc < w:\n                out[rr][cc] = color\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit","correct":false,"grid":[[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,2,3,3,6,7,3,3,3,3,3,3,3,3,3,3,3,8,3,3,3],[3,3,3,3,4,2,3,3,6,7,3,3,3,8,3,3,3,3,3,3,3,3,3],[3,3,3,2,6,0,4,4,2,2,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,7,2,6,3,4,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,7,7,6,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,2,3,3,3,3,3,3,3,3,3,3,3,3,8,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,8,3,3,3