        cells.append((x, y))\n                for nx, ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\n                    if 0 <= nx < h and 0 <= ny < w and (nx,ny) not in seen and grid[nx][ny] == color:\n                        seen.add((nx,ny))\n                        q.append((nx,ny))\n            rs = [x for x,y in cells]\n            cs = [y for x,y in cells]\n            comps.append((color, cells, min(rs), max(rs), min(cs), max(cs)))\n\n    # A long, thin component is the directional marker. Find the nearest\n    # separate colored object and recolor it to the marker's color.\n    markers = []\n    for comp in comps:\n        color, cells, r0, r1, c0, c1 = comp\n        height, width = r1-r0+1, c1-c0+1\n        if max(height, width) >= 4 and len(cells) >= 4:\n            markers.append(comp)\n    if not markers:\n        return [row[:] for row in grid]\n    marker = max(markers, key=lambda x: len(x[1]))\n    mc, _, mr0, mr1, mc0, mc1 = marker\n\n    candidates = []\n    for comp in comps:\n        color, cells, r0, r1, c0, c1 = comp\n        if comp is marker:\n            continue\n        # Do not treat another long line as the target.\n        if max(r1-r0+1, c1-c0+1) >= 6:\n            continue\n        dr = max(0, mr0-r1, r0-mr1)\n        dc = max(0, mc0-c1, c0-mc1)\n        candidates.append((dr+dc, len(cells), comp))\n    if not candidates:\n        return [row[:] for row in grid]\n    _, _, target = min(candidates, key=lambda x: (x[0], x[1]))\n    out = [row[:] for row in grid]\n    for r, c in target[1]:\n        out[r][c] = mc\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}}]}