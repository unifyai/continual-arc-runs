r v, n in counts.items() if v != bg and n <= max(10, h * w // 20)}\n    points = [(r, c) for r in range(h) for c in range(w) if grid[r][c] in rare]\n    if not points:\n        return grid\n\n    rows = sorted({r for r, c in points})\n    cols = sorted({c for r, c in points})\n\n    def step(vals):\n        d = 0\n        for a, b in zip(vals, vals[1:]):\n            d = gcd(d, b - a)\n        return d\n\n    rs, cs = step(rows), step(cols)\n\n    # Extend the intersection lattice where the known rows/columns show evidence.\n    if cs:\n        c = cols[0] - cs\n        while c >= 0 and any(grid[r][c] != bg for r in rows):\n            cols.insert(0, c)\n            c -= cs\n        c = cols[-1] + cs\n        while c < w and any(grid[r][c] != bg for r in rows):\n            cols.append(c)\n            c += cs\n\n    if rs:\n        r = rows[0] - rs\n        while r >= 0 and any(grid[r][c] != bg for c in cols):\n            rows.insert(0, r)\n            r -= rs\n        r = rows[-1] + rs\n        while r < h and any(grid[r][c] != bg for c in cols):\n            rows.append(r)\n            r += rs\n\n    if len(rows) < 2 or len(cols) < 2:\n        return [[8]]\n\n    out = []\n    for r in rows[:-1]:\n        out.append([8 if grid[r][c] == bg else grid[r][c] for c in cols[:-1]])\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit"}},{"step":26,"kind":"reprompt","phase":"act","t0":1790703375.08,"t1":1790703393.97,"alias":"task-aa0307f2","message":"Your program was checked on demo pair 1 at no cost and its output is wrong. It gave\n5 5 4 4 4 1 1\n5 5 4 4 4 1 1\n1 1 0 0 4 4 4\n1 1 0 0 0 9 9\nwhere the pair's output is\n5 8 8 8 8 1\n8 8 8 8 8 8\n1 8 0 8 8 8\n8 8 8 0 8 9\nFailed checks in this instance: 1 of 3. Reply with a corrected program and {\"action\": \"submit\"}, or with {\"action\": \"request_demos\"}.","reply":"{\"action\": \"request_demos\"}","steps":[],"action":{"type":"demo"}},{"step":26,"kind":"observation","phase":"act","t0":