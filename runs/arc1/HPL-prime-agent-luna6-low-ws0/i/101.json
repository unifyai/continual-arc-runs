rows = [r for r in range(h) if all(v == 2 for v in grid[r])]\n    if rows:\n        d = rows[0]\n        bg = max(set(v for row in grid for v in row), key=lambda v: sum(row.count(v) for row in grid))\n        cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] not in (bg, 2)]\n        lo, hi = min(r for r, c in cells), max(r for r, c in cells)\n        # Move colored pixels to abut the divider; add an 8-line just beyond them.\n        delta = (d + 1 - lo) if lo > d else (d - 1 - hi)\n        for r, c in cells:\n            out[r][c] = bg\n        for r, c in cells:\n            out[r + delta][c] = grid[r][c]\n        moved_lo, moved_hi = lo + delta, hi + delta\n        line = moved_hi + 1 if moved_lo > d else moved_lo - 1\n        out[line] = [8] * w\n        return out\n    d = next(c for c in range(w) if all(grid[r][c] == 2 for r in range(h)))\n    bg = max(set(v for row in grid for v in row), key=lambda v: sum(row.count(v) for row in grid))\n    cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] not in (bg, 2)]\n    lo, hi = min(c for r, c in cells), max(c for r, c in cells)\n    delta = (d + 1 - lo) if lo > d else (d - 1 - hi)\n    for r, c in cells:\n        out[r][c] = bg\n    for r, c in cells:\n        out[r][c + delta] = grid[r][c]\n    moved_lo, moved_hi = lo + delta, hi + delta\n    line = moved_hi + 1 if moved_lo > d else moved_lo - 1\n    for r in range(h):\n        out[r][line] = 8\n    return out\n'''\nopen(p,'w').write(src)\nprint('saved',len(src))","t":1790698492.4236748,"stored":["programs/task-4ae42b9f.py"],"output":"saved 1585\n"}],"action":{"type":"finish"}}]}