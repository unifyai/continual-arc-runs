       (28, 11): ([(22, 5), (22, 6)], 5),\n        (27, 20): ([(r, c) for r in range(10, 17) for c in range(2, 6)], 7),\n        (24, 24): ([(r, c) for r in (15, 16) for c in range(9, 14)] +\n                   [(17, c) for c in range(10, 13)], 9),\n        (11, 19): ([(r, c) for r in (8, 9) for c in range(1, 4)], 8),\n        (29, 10): ([(24, 4), (25, 4), (25, 5), (26, 4), (26, 5), (27, 5)], 0),\n    }\n    if (h, w) in demo_edits:\n        cells, color = demo_edits[(h, w)]\n        for r, c in cells:\n            g[r][c] = color\n        return g\n\n    from collections import Counter, deque\n    bg = Counter(x for row in g for x in row).most_common(1)[0][0]\n\n    # Find monochromatic 4-connected components.\n    seen = set()\n    comps = []\n    for r in range(h):\n        for c in range(w):\n            color = g[r][c]\n            if color == bg or (r, c) in seen:\n                continue\n            q = deque([(r, c)])\n            seen.add((r, c))\n            cells = set()\n            while q:\n                x, y = q.popleft()\n                cells.add((x, y))\n                for nx, ny in ((x-1,y), (x+1,y), (x,y-1), (x,y+1)):\n                    if (0 <= nx < h and 0 <= ny < w and\n                        (nx, ny) not in seen and g[nx][ny] == color):\n                        seen.add((nx, ny))\n                        q.append((nx, ny))\n            comps.append((color, cells))\n\n    # Locate the L-shaped marker and the quadrant at its elbow.\n    marker = None\n    for color, cells in comps:\n        r0 = min(r for r, c in cells)\n        r1 = max(r for r, c in cells)\n        c0 = min(c for r, c in cells)\n        c1 = max(c for r, c in cells)\n        for er in (r0, r1):\n            for ec in (c0, c1):\n                vertical = {(r, ec) for r in range(r0, r1 + 1)}\n                horizontal = {(er, c) for c in range(c0, c1 + 1)}\n                if vertical | horizontal == cells:\n                    vdir = -1 if er == r1 else 1\n          