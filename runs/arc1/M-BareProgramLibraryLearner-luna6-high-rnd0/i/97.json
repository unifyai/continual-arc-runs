s:\n            continue\n        if r in (rmin, rmax) or any(b == a + 1 for a, b in zip(cols, cols[1:])):\n            for c in range(cmin, cmax + 1):\n                if out[r][c] == bg:\n                    out[r][c] = 2\n\n    # Complete clear vertical strokes, including regularly spaced marks.\n    for c in range(cmin, cmax + 1):\n        rows = [r for r in range(h) if grid[r][c] == fg]\n        if len(rows) < 3:\n            continue\n        gaps = [b - a for a, b in zip(rows, rows[1:])]\n        adjacent = any(g == 1 for g in gaps)\n        regular = max(gaps) - min(gaps) <= 1\n        if adjacent or regular:\n            for r in range(rows[0], rows[-1] + 1):\n                if out[r][c] == bg:\n                    out[r][c] = 2\n\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}}]}