(a,b)==source or b-a != size: continue\\n        for dr in range(size):\\n            for c in range(w):\\n                if c in sep_cols: continue\\n                out[a+dr][c] = grid[sh+dr][c]\\n    return out\\n'''\n(base/'task-44dbc45f.py').write_text(code)\ngrid=[[3]*11 for _ in range(26)]\nfor r in range(26): grid[r][5]=2\nfor r in (8,17): grid[r]=[2]*11\n# motif\nmot={ (0,4):1,(3,2):6,(3,4):6,(4,2):1,(7,1):6,(7,2):6,(7,3):6}\nfor (r,c),v in mot.items(): grid[18+r][c]=v\nout=__import__('runpy').run_path(str(base/'task-44dbc45f.py'))['transform'](grid)\nprint(out)","t":1790704754.3083134,"stored":["programs/task-44dbc45f.py"],"output":"[[3, 3, 3, 3, 1, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 6, 3, 6, 2, 3, 3, 3, 3, 3], [3, 3, 1, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 6, 6, 6, 3, 2, 3, 3, 3, 3, 3], [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2], [3, 3, 3, 3, 1, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 6, 3, 6, 2, 3, 3, 3, 3, 3], [3, 3, 1, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 6, 6, 6, 3, 2, 3, 3, 3, 3, 3], [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2], [3, 3, 3, 3, 1, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 6, 3, 6, 2, 3, 3, 3, 3, 3], [3, 3, 1, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 6, 6, 6, 3, 2, 3, 3, 3, 3, 3]]\n"}],"action":{"type":"submit","grid":[[3,3,3,3,1,2,3,3,3,3,3],[3,3,3,3,3,2,3,3,3,3,3],[3,3,3,3,3,2,3,3,3,3,3],[3,3,6,3,6,2,3,3,3,3,3],[3,3,1,3,3,2,3,3,3,3,3],[3,3,3,3,3,2,3,3,3,3,3],[3,3,3,3,3,2,3,3,3,3,3],[3,6,6,6,3,2,3,3,3,3,3],[2,2,2,2,2,2,2,2,2,2,2],[3,3,3,3,1,2,3,3,3,3,3],[3,3,3,3,3,2,3,3,3,3,3],[3,3,3,3,3,2,3,3,3,3,3],[3,3,6,3,6,2,3,3,3,3,3],[3,3,1,3,3,2,3,3,3,3,3],[3,3,3,3,3,2,3,3,3,3,3],[3,3,3,3,3,2,3,3,3,3,3],[3,6,6,6,3,2,3