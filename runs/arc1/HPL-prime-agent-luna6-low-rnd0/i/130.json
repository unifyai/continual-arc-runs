 pairs aligned diagonally; extend the matching-color diagonal through\n    # background cells, stopping at other colored cells and grid edges.\n    pts = {}\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != bg:\n                pts.setdefault(grid[r][c], []).append((r,c))\n    for color, cells in pts.items():\n        for i, (r1,c1) in enumerate(cells):\n            for r2,c2 in cells[i+1:]:\n                dr, dc = r2-r1, c2-c1\n                if abs(dr) == abs(dc) and dr != 0:\n                    sr = 1 if dr > 0 else -1\n                    sc = 1 if dc > 0 else -1\n                    # Extend from both ends of the observed same-color segment.\n                    for rr,cc,step in ((r1-sr,c1-sc,-1),(r2+sr,c2+sc,1)):\n                        while 0 <= rr < h and 0 <= cc < w:\n                            if out[rr][cc] != bg:\n                                break\n                            out[rr][cc] = color\n                            rr += sr*step\n                            cc += sc*step\n    return out\n'''\nopen(p,'w').write(new)\n","t":1790700853.7480185,"stored":["programs/task-f9ba5620.py"],"output":"1235"}],"action":{"type":"finish"}}]}