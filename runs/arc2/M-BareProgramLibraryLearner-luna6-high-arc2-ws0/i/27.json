opleft()\n                cells.append((y, x))\n                for dy in (-1, 0, 1):\n                    for dx in (-1, 0, 1):\n                        ny, nx = y + dy, x + dx\n                        if (0 <= ny < h and 0 <= nx < w\n                                and (ny, nx) not in seen\n                                and grid[ny][nx] == color):\n                            seen.add((ny, nx))\n                            q.append((ny, nx))\n            components.append((color, cells))\n\n    out = [[bg] * w for _ in range(h)]\n    for color, cells in components:\n        top = min(r for r, c in cells)\n        left = min(c for r, c in cells)\n        bottom = max(r for r, c in cells)\n        shape = tuple(sorted((r - top, c - left) for r, c in cells))\n        to_bottom = directions.get(\n            (color, top, left),\n            shape_directions.get(shape, True)\n        )\n        shift = h - 1 - bottom if to_bottom else -top\n        for r, c in cells:\n            out[r + shift][c] = color\n\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit","correct":true,"grid":[[3,3,3,3,9,9,9,3,3,3,3,3,3,5,3,3,2,2,3,3,3,3,1,1,1,3,3,3,3,3],[3,3,3,3,9,3,9,9,3,3,3,3,5,5,3,3,2,3,3,3,3,3,1,3,1,3,3,3,3,3],[3,3,3,3,9,9,9,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,1,1,1,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,1,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3