w in grid for v in row).most_common(1)[0][0]\n\n    # Identify full-width divider rows.\n    div_rows = [r for r in range(h)\n                if len(set(grid[r])) == 1 and grid[r][0] != bg]\n\n    # The divider color is shared by the partial vertical dividers.\n    panels = []\n    row_starts = [0] + [r + 1 for r in div_rows]\n    row_ends = div_rows + [h]\n\n    for r0, r1 in zip(row_starts, row_ends):\n        if r0 >= r1:\n            continue\n        cuts = []\n        for c in range(w):\n            vals = {grid[r][c] for r in range(r0, r1)}\n            if len(vals) == 1 and next(iter(vals)) != bg:\n                cuts.append(c)\n\n        # Only treat a column as a divider if its color matches a horizontal\n        # divider, or if it is visibly a continuous line in this band.\n        div_colors = {grid[r][0] for r in div_rows}\n        cuts = [c for c in cuts if grid[r0][c] in div_colors]\n        cstarts = [0] + [c + 1 for c in cuts]\n        cends = cuts + [w]\n\n        for c0, c1 in zip(cstarts, cends):\n            if c0 < c1:\n                panels.append((r0, r1, c0, c1))\n\n    for r0, r1, c0, c1 in panels:\n        colors_at_depth = {}\n        for r in range(r0, r1):\n            for c in range(c0, c1):\n                v = grid[r][c]\n                if v != bg:\n                    d = min(r - r0, r1 - 1 - r, c - c0, c1 - 1 - c)\n                    colors_at_depth.setdefault(d, []).append(v)\n\n        if not colors_at_depth:\n            continue\n\n        seq = [Counter(colors_at_depth[d]).most_common(1)[0][0]\n               for d in sorted(colors_at_depth)]\n        for r in range(r0, r1):\n            for c in range(c0, c1):\n                d = min(r - r0, r1 - 1 - r, c - c0, c1 - 1 - c)\n                out[r][c] = seq[d % len(seq)]\n\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}}]}