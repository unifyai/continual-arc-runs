n grid]\n    h, w = len(g), len(g[0])\n    xs = [2, 7, 12, 17]\n    key_masks = []\n    key_colors = []\n    for c in xs:\n        cells = [(dr, dc) for dr in range(3) for dc in range(3)\n                 if grid[1 + dr][c + dc] != 8]\n        key_masks.append(frozenset(cells))\n        vals = [grid[1 + dr][c + dc] for dr, dc in cells]\n        key_colors.append(vals[0] if vals else 8)\n\n    # Matching motifs in the lower panels get a 5-by-5 background frame.\n    for r in [8, 13, 18, 23]:\n        for c in xs:\n            mask = frozenset((dr, dc) for dr in range(3) for dc in range(3)\n                             if grid[r + dr][c + dc] != 8)\n            if mask in key_masks:\n                for rr in range(max(0, r - 1), min(h, r + 4)):\n                    for cc in range(max(0, c - 1), min(w, c + 4)):\n                        if g[rr][cc] == 8:\n                            g[rr][cc] = 3\n\n    # The final two rows carry the most frequent key color.\n    counts = {}\n    for color in key_colors:\n        counts[color] = counts.get(color, 0) + 1\n    strip_color = max(counts, key=counts.get)\n    for r in range(h - 2, h):\n        for c in range(w):\n            if g[r][c] == 8:\n                g[r][c] = strip_color\n\n    return g\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit"}},{"step":206,"kind":"reprompt","phase":"act","t0":1790651029.747,"t1":1790651085.607,"alias":"task-bd3af3da","message":"Your program was checked on demo pair 1 at no cost and its output is wrong. It gave\n8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8\n8 8 0 0 0 8 8 1 1 1 8 8 7 8 8 8 8 8 6 6 8 8\n8 8 0 0 0 8 8 8 1 8 8 8 7 7 7 8 8 8 8 6 8 8\n8 8 0 0 0 8 8 1 1 1 8 8 7 8 8 8 8 8 6 6 8 8\n8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8\n6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6\n8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8\n8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8\n8 8 2 8 2 8 8 0 8 8 8 8 8 8 7 8 8 9 8 9 8 8\n8 8 8 2 8 8 8 0 0 0 8 8 8 8 7 8 8 9 9 8 8 8\n8 8 2 8 2 8 8 0