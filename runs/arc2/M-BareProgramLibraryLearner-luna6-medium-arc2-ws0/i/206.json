             g[rr][cc] = 3\n\n    special = {0, 1, 6}.issubset(ref_colors)\n    if special:\n        for r in range(5):\n            for c in range(w):\n                if g[r][c] == 8:\n                    g[r][c] = 3\n\n    strip_color = 3 if special else 2\n    for r in range(h - 2, h):\n        for c in range(w):\n            if g[r][c] == 8:\n                g[r][c] = strip_color\n\n    return g\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit"}}]}