-1), (1, 0), (-1, 0)):\n                rr, cc = r + dr, c + dc\n                distance = 1\n                while 0 <= rr < h and 0 <= cc < w:\n                    value = original[rr][cc]\n                    if value not in (0, 2, 4):\n                        votes[value] = votes.get(value, 0) + 1.0 / distance\n                        break\n                    rr += dr\n                    cc += dc\n                    distance += 1\n            if votes:\n                work[r][c] = max(votes, key=votes.get)\n\n    claims = [[[] for _ in range(w)] for _ in range(h)]\n\n    def add_segment(axis, fixed, start, end, color):\n        for pos in range(start, end + 1):\n            r, c = (fixed, pos) if axis == \"h\" else (pos, fixed)\n            claims[r][c].append(\n                (color, axis, original[r][c] != color, end - start)\n            )\n\n    # Paired 2-markers delimit full straight segments.\n    for r in range(h):\n        markers = [c for c in range(w) if original[r][c] == 2]\n        for a, b in zip(markers, markers[1:]):\n            color = work[r][a]\n            if color == work[r][b] and color not in (0, 2, 4):\n                add_segment(\"h\", r, a, b, color)\n\n    for c in range(w):\n        markers = [r for r in range(h) if original[r][c] == 2]\n        for a, b in zip(markers, markers[1:]):\n            color = work[a][c]\n            if color == work[b][c] and color not in (0, 2, 4):\n                add_segment(\"v\", c, a, b, color)\n\n    # Complete short gaps in otherwise aligned strokes.\n    for r in range(h):\n        for color in set(work[r]) - {0, 2, 4}:\n            positions = [c for c in range(w) if work[r][c] == color]\n            for a, b in zip(positions, positions[1:]):\n                if b - a <= 2:\n                    add_segment(\"h\", r, a, b, color)\n\n    for c in range(w):\n        for color in {work[r][c] for r in range(h)} - {0, 2, 4}:\n            positions = [r for r in range(h) if work[r][c] == color]\n            for a, b in zip(positions, positions[1:]):\n                if b - a <= 2:\n                    add_segment(\"v\", c, a, b, color)\n\n    out = [row[:] for row in original]\n    for r in range(h):\n        for c in range(w):\n            if original[r][c] == 2 and work[r][c] not in (0, 2, 4):\n                out[r][c] = work[r][c]\n            if claims[r][c]:\n                best_missing = max(claim[2] for claim in claims[r][c])\n                candidates = [claim for claim in claims[r][c]\n                              if claim[2] == best_missing]\n                candidates.sort(key=lambda claim:\n                                (claim[1] == \"h\", -claim[3]))\n                out[r][c] = candidates[-1][0]\n\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit"}}]}