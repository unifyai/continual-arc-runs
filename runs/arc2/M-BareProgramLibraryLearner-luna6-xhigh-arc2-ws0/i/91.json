set()\n            existing_ports = set()\n            abs_ports = []\n            for j in placed:\n                pos = positions[j]\n                existing_cells |= shifted(pieces[j][\"cells\"], pos)\n                pp = shifted(pieces[j][\"ports\"], pos)\n                existing_ports |= pp\n                abs_ports.extend(pp)\n\n            for i in remaining:\n                p = pieces[i]\n                if not p[\"ports\"]:\n                    continue\n                poss = set()\n                for py, px in p[\"ports\"]:\n                    for qy, qx in abs_ports:\n                        poss.add((qy - py, qx - px))\n\n                for pos in poss:\n                    cells = shifted(p[\"cells\"], pos)\n                    ports = shifted(p[\"ports\"], pos)\n                    if not cells or any(y < 0 or y >= h or x < 0 or x >= w\n                                         for y, x in cells | ports):\n                        continue\n                    if cells & existing_cells or cells & existing_ports or ports & existing_cells:\n                        continue\n                    newpos = list(positions)\n                    newpos[i] = pos\n                    key = tuple(newpos)\n                    if key not in next_states:\n                        next_states[key] = None\n\n        if not next_states:\n            break\n\n        scored = []\n        for positions in next_states:\n            matched, joints, area, _, _ = state_info(positions)\n            # Prefer assemblies with many joined endpoints, and among those,\n            # compact configurations.\n            scored.append(((matched, joints, -area), positions))\n        scored.sort(key=lambda z: z[0], reverse=True)\n        beam = [p for _, p in scored[:width]]\n\n    # Select the best complete assembly found.\n    complete = [p for p in beam if all(x is not None for x in p)]\n    if complete:\n        best = max(complete, key=lambda p: (\n            state_info(p)